            "dataType": "double",
            "sourceColumn": "Gross Margin Rate"
          },
          {
            "name": "EBITDA Margin",
            "dataType": "double",
            "sourceColumn": "EBITDA Margin"
          },
          {
            "name": "EBITDA Attainment",
            "dataType": "double",
            "sourceColumn": "EBITDA Attainment"
          },
          {
            "name": "Forecast Accuracy",
            "dataType": "double",
            "sourceColumn": "Forecast Accuracy"
          }
        ],
        "partitions": [
          {
            "name": "monthly_performance",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Binary = Binary.FromText(\"\", BinaryEncoding.Base64),",
                "    Source = Csv.Document(Binary, [Delimiter=\",\", Columns=19, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"Month\", type date}, {\"Month Key\", type text}, {\"Period\", type text}, {\"Revenue\", type number}, {\"Budget Revenue\", type number}, {\"Gross Profit\", type number}, {\"Operating Expense\", type number}, {\"EBITDA\", type number}, {\"Budget EBITDA\", type number}, {\"Depreciation\", type number}, {\"EBIT\", type number}, {\"Net Income\", type number}, {\"Ending Cash\", type number}, {\"Headcount\", Int64.Type}, {\"CCC Days\", type number}, {\"Gross Margin Rate\", type number}, {\"EBITDA Margin\", type number}, {\"EBITDA Attainment\", type number}, {\"Forecast Accuracy\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "KPI Revenue",
            "expression": "SUM(monthly_performance[Revenue])",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI Budget Revenue",
            "expression": "SUM(monthly_performance[Budget Revenue])",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI Gross Profit",
            "expression": "SUM(monthly_performance[Gross Profit])",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI Operating Expense",
            "expression": "SUM(monthly_performance[Operating Expense])",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI EBITDA",
            "expression": "SUM(monthly_performance[EBITDA])",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI Budget EBITDA",
            "expression": "SUM(monthly_performance[Budget EBITDA])",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI Depreciation",
            "expression": "SUM(monthly_performance[Depreciation])",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI EBIT",
            "expression": "SUM(monthly_performance[EBIT])",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI Net Income",
            "expression": "SUM(monthly_performance[Net Income])",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI Ending Cash",
            "expression": "MAX(monthly_performance[Ending Cash])",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI Headcount",
            "expression": "MAX(monthly_performance[Headcount])",
            "formatString": "#,0"
          },
          {
            "name": "KPI CCC Days",
            "expression": "AVERAGE(monthly_performance[CCC Days])",
            "formatString": "0.0"
          },
          {
            "name": "KPI Gross Margin",
            "expression": "DIVIDE([KPI Gross Profit],[KPI Revenue],0)",
            "formatString": "0.0%"
          },
          {
            "name": "KPI EBITDA Margin",
            "expression": "DIVIDE([KPI EBITDA],[KPI Revenue],0)",
            "formatString": "0.0%"
          },
          {
            "name": "KPI EBITDA Attainment",
            "expression": "DIVIDE([KPI EBITDA],[KPI Budget EBITDA],0)",
            "formatString": "0.0%"
          },
          {
            "name": "KPI Forecast Accuracy",
            "expression": "AVERAGE(monthly_performance[Forecast Accuracy])",
            "formatString": "0.0%"
          },
          {
            "name": "KPI Revenue PY",
            "expression": "CALCULATE([KPI Revenue],DATEADD(dim_calendar[Date],-1,YEAR))",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI EBITDA PY",
            "expression": "CALCULATE([KPI EBITDA],DATEADD(dim_calendar[Date],-1,YEAR))",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI Revenue YoY %",
            "expression": "DIVIDE([KPI Revenue]-[KPI Revenue PY],[KPI Revenue PY],0)",
            "formatString": "0.0%"
          },
          {
            "name": "KPI EBITDA YoY %",
            "expression": "DIVIDE([KPI EBITDA]-[KPI EBITDA PY],[KPI EBITDA PY],0)",
            "formatString": "0.0%"
          },
          {
            "name": "KPI Revenue Variance",
            "expression": "[KPI Revenue]-[KPI Budget Revenue]",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI Revenue Variance %",
            "expression": "DIVIDE([KPI Revenue Variance],[KPI Budget Revenue],0)",
            "formatString": "0.0%"
          },
          {
            "name": "KPI EBITDA Margin Target",
            "expression": "0.10",
            "formatString": "0.0%"
          },
          {
            "name": "KPI Cash Target",
            "expression": "200000000",
            "formatString": "₺#,0"
          }
        ]
      },
